{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "location": {
                "type": "string",
                "description": "ISO 3166-1 alpha-2 code, or 'GLOBAL' for the un-filtered ranking."
            },
            "category": {
                "type": ["string", "null"],
                "description": "Cloudflare Radar category name used as the filter, or null for an all-category query."
            },
            "rank": {
                "type": "integer",
                "description": "Position within this category for this location (1 = top in the category)."
            },
            "overallRank": {
                "type": "integer",
                "description": "Domain's raw position in Cloudflare's top-100 ranking for the location (or global)."
            },
            "domain": {
                "type": "string",
                "description": "Domain name."
            },
            "pctRankChange": {
                "type": "number",
                "description": "Percentage rank change vs the previous period."
            },
            "categories": {
                "type": "array",
                "description": "All categories the domain belongs to, as returned by Cloudflare.",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": { "type": "integer" },
                        "name": { "type": "string" },
                        "superCategoryId": { "type": "integer" }
                    }
                }
            },
            "rankingType": {
                "type": "string",
                "description": "POPULAR, TRENDING_RISE, or TRENDING_STEADY."
            },
            "date": {
                "type": ["string", "null"],
                "description": "Date passed to the API, or null for 'most recent'."
            }
        },
        "required": ["location", "rank", "domain", "rankingType"]
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": ["location", "category", "rank", "domain", "overallRank", "pctRankChange", "rankingType", "date"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "location": { "label": "Location" },
                    "category": { "label": "Category" },
                    "rank": { "label": "Category rank" },
                    "domain": { "label": "Domain" },
                    "overallRank": { "label": "Overall rank" },
                    "pctRankChange": { "label": "% rank change" },
                    "rankingType": { "label": "Ranking type" },
                    "date": { "label": "Date" }
                }
            }
        }
    }
}
